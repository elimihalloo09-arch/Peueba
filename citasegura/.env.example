# === WhatsApp Cloud API (Meta for Developers) ===
WA_TOKEN=pega_aqui_tu_token_de_acceso
WA_PHONE_NUMBER_ID=pega_aqui_el_phone_number_id
WA_VERIFY_TOKEN=inventa_una_palabra_secreta
WA_APP_SECRET=pega_aqui_el_app_secret
GRAPH_VERSION=v21.0
# Nombre de la plantilla de recordatorio aprobada por Meta
WA_TEMPLATE_RECORDATORIO=recordatorio_cita
# Plantilla de 2 h con direccion y Maps; vacia = usar la de arriba mientras Meta la aprueba
WA_TEMPLATE_RECORDATORIO_2H=

# === Claude ===
ANTHROPIC_API_KEY=pega_aqui_tu_api_key
CLAUDE_MODEL=claude-haiku-4-5-20251001

# === Clinica (demo) ===
CLINICA_NOMBRE=Clinica Dental Sonrisa
CLINICA_DIRECCION=Av. Ejemplo 123, Col. Benito Juarez, Nezahualcoyotl
# Link de "Compartir" del consultorio en Google Maps
CLINICA_MAPS=https://maps.google.com/?q=Nezahualcoyotl
# WhatsApp del consultorio: recibe avisos (cita nueva, cancelada, movida, urgencias) y manda #comandos
TELEFONO_HUMANO=5215500000000
# 0 = no mandar avisos de citas nuevas/canceladas/movidas
AVISAR_CONSULTORIO=1
# Plantilla de Utilidad para que los avisos lleguen aunque el consultorio no haya escrito en 24 h
# (vacia = texto libre, gratis pero solo dentro de la ventana de 24 h)
WA_TEMPLATE_AVISO=
DB_PATH=citasegura.db

# === Produccion (solo en el servidor; ver DESPLIEGUE.md) ===
# Dominio que apunta al servidor; Caddy le pone HTTPS solo
DOMINIO=bot.tudominio.com
